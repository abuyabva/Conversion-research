# Local synthetic-data credentials only. Never reuse production credentials.
POSTGRES_PASSWORD=local-synthetic-only
AGENT_MODE=Demo
LLM_BASE_URL=https://api.openai.com/v1/
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Auto detects local Ollama on port 11434; explicit values: OpenAI, Ollama.
LLM_PROVIDER=Auto
# For local Ollama with Docker Desktop, change the values above:
# AGENT_MODE=Llm
# LLM_BASE_URL=http://host.docker.internal:11434/v1/
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama
# LLM_PROVIDER=Ollama
